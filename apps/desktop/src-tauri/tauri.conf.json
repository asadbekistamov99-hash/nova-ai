{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../dist"
  },
  "package": {
    "productName": "NOVA AI",
    "version": "1.0.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.nova.ai",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "NOVA AI",
        "width": 1240,
        "height": 800,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
